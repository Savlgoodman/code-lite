{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@code-lite/protocol": ["./protocol/src/index.ts"],
      "@code-lite/transport": ["./transport/src/index.ts"]
    }
  },
  "include": ["protocol/src", "transport/src"]
}
